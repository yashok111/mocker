# Environment for `docker compose up` (see docker-compose.yml, which loads
# this file verbatim via env_file). `make up` on a tree with no .env creates
# one from this file with a real password hash (scripts/init-env.sh); by
# hand:
#
#   make init PASSWORD=…      # or: cp .env.example .env and fill in the hash
#
# Every variable mocker reads is MOCKER_*, listed here in the order DESIGN.md
# §16 documents them. Nothing is read from a config file — the container is
# fully configurable by environment alone, which is what makes `docker save`/
# `docker load` a complete deployment in a closed contour.

# ---------------------------------------------------------------------------
# Localhost / docker compose quick start
# ---------------------------------------------------------------------------

# Listen address.
MOCKER_ADDR=:8080

# debug | info | warn | error
MOCKER_LOG_LEVEL=info

# MANDATORY for the plain-http compose file. MOCKER_DEV drops the `Secure`
# attribute from the session cookie. Without it CookieSecure() stays true,
# curl (and any browser) will not send a Secure cookie back over plain http,
# and admin login fails with the mock plane's routing never even exercised.
# Set to 1 here; never set it in a real deployment (see the contour section
# below). The HTTPS overlay (docker-compose.tls.yml, `make up-tls`) forces
# it back to 0 itself — a Secure cookie is exactly what TLS in front is for.
MOCKER_DEV=1

# Workspace hosts are <slug>.<MOCKER_BASE_DOMAIN>; the smoke test and the
# quick start in README.md both reach this pair with an explicit Host
# header on curl, so no DNS setup is required.
MOCKER_BASE_DOMAIN=mock.local
MOCKER_ADMIN_HOST=mocker.local

# host | path. "path" is the wildcard-DNS-less emergency mode (DESIGN §16);
# the default is what this compose file and the smoke test exercise.
MOCKER_ROUTING=host

# Reserved on every workspace host: GET <prefix>/health, POST <prefix>/state.
MOCKER_RESERVED_PREFIX=/__mocker

# Only mode P0 ships. Requires MOCKER_SHARED_PASSWORD_HASH below.
MOCKER_AUTH_MODE=shared-password

# argon2id hash of the admin password, generated with `make hash-password`
# (wraps `go run ./cmd/mocker hash-password`, which needs no env configured
# at all). The placeholder below is NOT a valid hash — login will fail until
# you replace it (the server itself still starts; only SharedPasswordHash
# being non-empty is checked at startup).
#
# Paste the printed hash VERBATIM, dollar signs and all — do not escape them.
# The PHC format is `$argon2id$v=19$m=...$<salt>$<hash>`, and docker-compose.yml
# reads this file with `format: raw` precisely so those `$` survive; `docker
# run --env-file` never interpolates either. Escaping them to `$$` is what
# breaks it.
MOCKER_SHARED_PASSWORD_HASH=REPLACE_ME_RUN_MAKE_HASH_PASSWORD

# Numeric id (specs.id) of a spec ALREADY IMPORTED into this deployment
# (import it first via the admin UI or POST /api/specs, read its id back off
# the response or the specs list) — not a name (not unique) and not a path
# or URL (nothing here reads a document off disk or the network at boot).
# When set and a brand-new user's first login finds them with zero
# workspaces, one is auto-created against this spec, slug derived from their
# name (DESIGN §14 screen 2); a value that names no spec fails startup
# loudly instead of silently never auto-creating. Empty = skip auto-create,
# same as today. Leave empty for the quick start.
MOCKER_DEFAULT_SPEC=

# SQLite lives at $MOCKER_DATA_DIR/mocker.db, on the named volume mounted by
# docker-compose.yml.
MOCKER_DATA_DIR=/data

# ---------------------------------------------------------------------------
# Limits and retention (DESIGN §16 defaults — override only if you must)
# ---------------------------------------------------------------------------

# Request body size limit.
MOCKER_MAX_BODY=10mb

# Ceiling on a single generated mock response.
MOCKER_MAX_RESPONSE=4mb

# Ceiling on entities per resource (stateful resources, P3+).
MOCKER_MAX_ENTITIES=1000

# How much of a traffic entry's body is kept in the log.
MOCKER_TRAFFIC_MAX_BODY=8kb

# Traffic log entries retained per workspace.
MOCKER_TRAFFIC_RETENTION=1000

# Machine-made checkpoints retained per workspace -- everything except a
# named ("manual") one counts: the pre-destructive snapshot written before a
# rollback or reset-overrides, and (P2d) the debounced "auto" row
# MOCKER_CHECKPOINT_DEBOUNCE below writes. Manual checkpoints are never
# pruned by this, however many exist.
# 0 means "prune nothing" -- a deliberate departure from
# MOCKER_TRAFFIC_RETENTION's 0, which normalises to the 1000-row default
# instead (internal/checkpoints/repo.go's NewRepo comment on why a history
# knob and a hot-path firehose default differently).
MOCKER_CHECKPOINT_RETENTION=20

# resource_suggestions generations kept per spec_id, oldest pruned first
# (P3f, "rederive"). Bounded growth only -- nothing reads a non-newest
# generation yet, so this is a ceiling, not a feature. 0 means keep every
# generation, the same "0 means do less" shape MOCKER_CHECKPOINT_RETENTION's
# own 0 already uses above.
MOCKER_SUGGESTION_RETENTION=3

# Minimum gap, in seconds, between debounced ("auto") checkpoints the server
# writes in front of a handful of labelled admin mutations (edits to a
# workspace's settings, its operation overrides, its custom endpoints) --
# a safety snapshot per meaningful edit rather than one per keystroke while
# an operator revises the same field a dozen times in a row. 0 disables the
# trigger entirely: no auto rows are ever written, the same "0 means do
# less" shape MOCKER_CHECKPOINT_RETENTION's own 0 already uses above.
MOCKER_CHECKPOINT_DEBOUNCE=300

# In-memory runtimes cached across workspaces, evicted least-recently-used.
MOCKER_RUNTIME_CACHE=32

# The admin plane's traffic feed over Server-Sent Events (P6a,
# GET /api/workspaces/{id}/traffic/stream). All three are integer SECONDS --
# the same shape MOCKER_CHECKPOINT_DEBOUNCE uses, not Go duration strings --
# and all three must be at least 1: 0 fails startup, because a zero ping or
# recheck interval is a ticker that fires continuously and a zero frame
# deadline expires every write before it is attempted. There is no
# "disabled" reading for any of them.
#
# Interval of the `:ping` comment frame that keeps an idle stream alive
# through a proxy and gives a peer that went away without closing something
# to fail on.
MOCKER_STREAM_PING=15

# Deadline set on EACH frame write (and cleared after it) -- the bound that
# disconnects a client which stopped reading its socket instead of parking
# the writer forever. The connection's own deadline stays cleared: the SSE
# handler exempts itself from the server's global 30 s WriteTimeout per
# connection rather than that value being raised for everyone.
MOCKER_STREAM_FRAME_TIMEOUT=5

# How often a live stream re-validates its session AND its workspace (by
# identity, not id) against the database, closing the connection when the
# session was logged out elsewhere or the workspace was deleted.
MOCKER_STREAM_SESSION_RECHECK=60

# The mock plane's SSE endpoints (P6b, DESIGN §30.11): a custom endpoint of
# kind "sse" answers a Server-Sent Events stream to an unauthenticated
# client. Three knobs; the ping interval and the per-frame deadline above are
# shared with the admin feed.
#
# Live SSE mock connections per WORKSPACE. A CONCURRENCY cap, never a rate
# limit -- ten thousand short requests are unaffected, which is what §18
# protects. 0 refuses every stream handshake outright (the one MOCKER_STREAM_*
# value whose zero means something).
MOCKER_STREAM_MAX_CONNS=200

# Seconds a mock stream may live before the server closes it; a forgotten
# browser tab cannot pin a slot for a week. Must be >= 1. The admin traffic
# feed keeps its own fixed 900 s.
MOCKER_STREAM_MAX_LIFETIME=900

# What of a stream connection the traffic recorder stores beside its one row
# per connection (status, duration, frame count in notes): off -- no body;
# first -- the first frame each way (the response body, and for WebSocket
# the first inbound JSON object, redacted, as the request body); all (A14) --
# every frame each way into that SAME row, whole frames only, one per line
# for WebSocket (NDJSON), bounded by the two budgets below: the row is
# marked truncated when a cap stops the log, and frames_recorded:N /
# frames_in_recorded:M in the notes say how many were kept. The row count
# is unchanged, so frames never evict ordinary traffic rows (§30.13).
MOCKER_STREAM_TRAFFIC_FRAMES=off
# "all"'s per-row budget, each way: at least 1 frame and 1kb.
MOCKER_STREAM_TRAFFIC_MAX_FRAMES=200
MOCKER_STREAM_TRAFFIC_MAX_BYTES=64kb
# P6d: WebSocket mock endpoints (kind "ws"). MOCKER_STREAM_MAX_FRAME caps an
# INBOUND frame (a bigger one closes the connection with 1009; outbound stays
# under MOCKER_MAX_RESPONSE). MOCKER_STREAM_SEND_BUDGET bounds, in bytes, the
# per-connection queue of reactive/echo replies: a reply over it is dropped
# and counted, never blocks, and the client sees one {"$gap": N} frame when
# writing resumes. MOCKER_STREAM_ORIGINS is an allowlist of scheme://host[:port]
# (comma or space separated); empty means any origin (the mock plane's
# contract), a request with NO Origin header is always allowed. Both sizes
# must be at least 1kb.
MOCKER_STREAM_MAX_FRAME=64kb
MOCKER_STREAM_SEND_BUDGET=256kb
MOCKER_STREAM_ORIGINS=

# A6 (DESIGN §32): uploaded files a mock can serve. MOCKER_MAX_ASSET caps
# one file (PUT /api/workspaces/{id}/assets/{name}, the body IS the file;
# 413 asset_too_large over it) and may not exceed MOCKER_MAX_BODY, whose
# limit would otherwise refuse the upload first with a 413 naming the wrong
# knob; MOCKER_MAX_ASSETS_TOTAL caps a workspace's stored sum (413
# assets_quota) and may not be below the per-file cap. Both are refused by
# name, never clamped; the floor on the per-file cap is 1kb. No checkpoint
# and no bundle carries asset bytes — a deleted asset comes back only by a
# new upload under the same name.
MOCKER_MAX_ASSET=8mb
MOCKER_MAX_ASSETS_TOTAL=64mb


# off | comma-separated CIDR/address list, optionally with a bare integer hop
# count mixed in (e.g. "10.0.0.0/8" or "1,10.0.0.0/8" — see deploy/Caddyfile
# and docker-compose.tls.yml). A hop count alone is refused: it only says
# how deep into X-Forwarded-For to read, never which peer to believe it
# FROM, so at least one CIDR/address is required before anything is
# trusted. Off by default:
# with an open mock plane the immediate peer address is the only compensating
# control (DESIGN §15), so trusting X-Forwarded-* has to be opted into
# explicitly. Leave off for the localhost quick start — curl talks to mocker
# directly, there is no reverse proxy in front of it. The HTTPS overlay
# (docker-compose.tls.yml) overrides it with Caddy's ONE static address —
# never the subnet, whose .1 is the docker host; scripts/smoke-tls.sh
# check 5 is what that buys.
MOCKER_TRUST_PROXY=off

# Space/comma-separated allowlist of domains and CIDRs for "import spec by
# URL". Empty = that feature is off. Not exercised by P0.
MOCKER_URL_IMPORT_ALLOWLIST=

# Bearer key for POST /mcp — the MCP (Model Context Protocol) endpoint on the
# admin host, exposing task-named tools over the admin API to MCP clients
# (LLM agents), authenticated by this key instead of the session cookie.
# Empty (shipped here, the default): the route is not mounted at all, not
# even behind a 401 — an unconfigured deployment has no MCP surface to
# attack. Set a real value to enable /mcp; a non-empty value shorter than 32
# bytes fails startup (same "misconfiguration fails on the ground" policy as
# every other MOCKER_* variable). Compared in constant time and never
# logged; generate one the same way you would any other bearer token, e.g.
# `openssl rand -base64 32`.
MOCKER_MCP_KEY=

# ---------------------------------------------------------------------------
# Real (corporate-contour) deployment — DO NOT copy the block above verbatim
# ---------------------------------------------------------------------------
# - MOCKER_DEV must be unset/0: a real deployment needs the Secure cookie.
# - MOCKER_BASE_DOMAIN / MOCKER_ADMIN_HOST become the contour's real names,
#   e.g. mock.corp.internal / mocker.corp.internal (see deploy/Caddyfile).
# - MOCKER_TRUST_PROXY must name the reverse proxy's CIDR/address (a hop
#   count may ride along too, but never alone) once TLS terminates in front
#   of mocker, or X-Forwarded-Proto is not believed and the Secure cookie /
#   traffic source both stay wrong (DESIGN §15/§16).
# docker-compose.tls.yml (`make up-tls`) is that shape with Caddy's own
# local CA standing in for the contour's certificate: the three lines above
# are what it changes, and scripts/smoke-tls.sh checks each of them.
