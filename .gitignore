# build output
/bin/
/dist/
/mocker
*.test
*.out

# local data volume (SQLite + WAL)
/data/
*.db
*.db-wal
*.db-shm

# agent skills: canonical copies + Claude Code symlinks are generated.
# skills-lock.json IS tracked — restore with scripts/install-skills.sh
/.agents/
/.claude/skills/

# UI build artefacts (the embedded dist is produced by `make ui`). Vite's
# outDir is internal/webui/dist now (go:embed cannot reach outside its own
# package) — web/dist/ never gets written and the old rule for it is stale.
/web/node_modules/

# "dist/*" ignores the CONTENTS, not the directory: a rule on the directory
# itself (e.g. "/internal/webui/dist/") cannot be undone by a negation for a
# single file inside it, so .gitkeep would end up unignored AND untracked —
# invisible to git status, silently absent from a fresh clone, and the
# go:embed in internal/webui/webui.go fails to compile with no dist/ at all.
# The negation below re-includes exactly the placeholder.
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# local env
.env
.env.local

# real OpenAPI documents dropped at the root for a manual import check stay
# out of git: they are somebody's internal API. The acceptance tests do not
# read them — their corpus is embedded (internal/testspec/testdata).
/*.swagger.json
/testdata/specs/real/

# editors / OS
.DS_Store
.idea/
.vscode/

# wfcheck --freeze snapshots of workflow scripts, one per gate round: local
# review artefacts, and a "git add -N ." in a reviewer prompt would otherwise
# intent-add ~200 KB apiece.
.wf/

# python bytecode from py_compile (scripts/wsclient.py, the smoke pre-flight)
__pycache__/

# the local CA root exported by `make tls-root` (docker-compose.tls.yml);
# it is per-volume, regenerated by Caddy, and nobody else's to trust
/mocker-root.crt

# @yashok111/mocker-test (packages/mocker-test): its own yarn install and tsc output.
/packages/*/node_modules/
/packages/*/dist/
