    "svc.orders": {"path": "wiring.ts.txt","startLine": 23,"endLine": 23,"text": "const ordersService = service(\"orders\", { sources: [\"orders.ts.txt\", \"jobs.ts.txt\"], channels: [primary, secondary, returns, retry, dlq, orphan] });"},
    "svc.billing": {"path": "wiring.ts.txt","startLine": 24,"endLine": 24,"text": "const billingService = service(\"billing\", { sources: [\"billing.ts.txt\"], consumers: [known, distinct, orphanConsumer, fraud, audit, legacy] });"},
    "msg.orders": {"path": "orders.ts.txt","startLine": 2,"endLine": 4,"text": "const orderEvents = defineMessage(\"orders.cancelled.v1\", \"OrderCancelled\", {\n  orderId: \"string\", status: \"string\", reason: \"string\"\n});"},
    "msg.returns": {"path": "orders.ts.txt","startLine": 5,"endLine": 7,"text": "const secondaryEvents = defineMessage(\"returns.cancelled.v1\", \"OrderCancelled\", {\n  orderId: \"string\", status: \"string\"\n});"},
    "flow.cancel": {"path": "orders.ts.txt","startLine": 9,"endLine": 23,"text": "async function cancelOrder(db, broker, billingHttp, orderId, operatorReason) {\n  const tx = await db.begin(\"orders\", \"read committed\");\n  const row = await tx.query(\n    \"UPDATE orders SET status = 'cancelled' WHERE id = $1 RETURNING id, status\",\n    [orderId]\n  );\n  const reason = `${row.status}:${operatorReason}`;\n  const event = { orderId: row.id, status: row.status, reason };\n  await broker.publish(\"orders.primary\", orderEvents, event);\n  await broker.publish(\"orders.secondary\", orderEvents, event);\n  // Publication precedes commit; this is neither an outbox nor atomic delivery.\n  await tx.commit();\n  await billingHttp.invokeOperation(\"billing.cancel-order.v1\", { orderId });\n  return row.status;\n}"},
    "tx.begin": {"path": "orders.ts.txt","startLine": 10,"endLine": 10,"text": "  const tx = await db.begin(\"orders\", \"read committed\");"},
    "db.status": {"path": "orders.ts.txt","startLine": 11,"endLine": 14,"text": "  const row = await tx.query(\n    \"UPDATE orders SET status = 'cancelled' WHERE id = $1 RETURNING id, status\",\n    [orderId]\n  );"},
    "transform.reason": {"path": "orders.ts.txt","startLine": 15,"endLine": 15,"text": "  const reason = `${row.status}:${operatorReason}`;"},
    "serialize": {"path": "orders.ts.txt","startLine": 16,"endLine": 16,"text": "  const event = { orderId: row.id, status: row.status, reason };"},
    "emit.primary": {"path": "orders.ts.txt","startLine": 17,"endLine": 17,"text": "  await broker.publish(\"orders.primary\", orderEvents, event);"},
    "emit.secondary": {"path": "orders.ts.txt","startLine": 18,"endLine": 18,"text": "  await broker.publish(\"orders.secondary\", orderEvents, event);"},
    "tx.commit": {"path": "orders.ts.txt","startLine": 19,"endLine": 20,"text": "  // Publication precedes commit; this is neither an outbox nor atomic delivery.\n  await tx.commit();"},
    "call.billing": {"path": "orders.ts.txt","startLine": 21,"endLine": 21,"text": "  await billingHttp.invokeOperation(\"billing.cancel-order.v1\", { orderId });"},
    "flow.return": {"path": "orders.ts.txt","startLine": 25,"endLine": 28,"text": "async function cancelReturn(broker, returnRow) {\n  const event = { orderId: returnRow.orderId, status: returnRow.status };\n  await broker.publish(\"returns.primary\", secondaryEvents, event);\n}"},
    "emit.returns": {"path": "orders.ts.txt","startLine": 27,"endLine": 27,"text": "  await broker.publish(\"returns.primary\", secondaryEvents, event);"},
    "handler.cancel": {"path": "billing.ts.txt","startLine": 2,"endLine": 6,"text": "async function onOrderCancelled(bytes, billingStore) {\n  const decoded = decode(\"orders.cancelled.v1\", bytes);\n  const status = decoded.status;\n  await billingStore.markCancelled(decoded.orderId, status);\n}"},
    "decode.cancel": {"path": "billing.ts.txt","startLine": 3,"endLine": 4,"text": "  const decoded = decode(\"orders.cancelled.v1\", bytes);\n  const status = decoded.status;"},
    "handler.return": {"path": "billing.ts.txt","startLine": 7,"endLine": 10,"text": "async function onReturnCancelled(bytes, billingStore) {\n  const decoded = decode(\"returns.cancelled.v1\", bytes);\n  await billingStore.markReturned(decoded.orderId, decoded.status);\n}"},
    "handler.orphan": {"path": "billing.ts.txt","startLine": 11,"endLine": 11,"text": "function onOrphan(bytes) { return decode(\"orders.cancelled.v1\", bytes); }"},
    "handler.audit": {"path": "billing.ts.txt","startLine": 12,"endLine": 12,"text": "function onAudit(bytes) { return auditLog(decode(\"orders.cancelled.v1\", bytes)); }"},
    "operation.billing": {"path": "billing.ts.txt","startLine": 14,"endLine": 14,"text": "const cancelOrderOperation = httpOperation(\"billing.cancel-order.v1\", \"POST\", \"/internal/orders/cancel\", cancelOrderHttp);"},
    "handler.http": {"path": "billing.ts.txt","startLine": 15,"endLine": 18,"text": "async function cancelOrderHttp(request, billingStore) {\n  await billingStore.markCancelled(request.orderId, \"cancelled\");\n  return { accepted: true };\n}"},
    "job.cron": {"path": "jobs.ts.txt","startLine": 2,"endLine": 4,"text": "const sweep = job(\"orders.sweep\", \"Cancellation sweep\", {\n  trigger: { cron: \"0 3 * * *\", timezone: \"UTC\" }, handler: sweepCancelled\n});"},
    "handler.cron": {"path": "jobs.ts.txt","startLine": 5,"endLine": 7,"text": "async function sweepCancelled(db) {\n  return db.query(\"SELECT id FROM orders WHERE status = 'cancelled'\");\n}"},
    "job.manual": {"path": "jobs.ts.txt","startLine": 8,"endLine": 10,"text": "const replay = job(\"orders.replay\", \"Manual replay\", {\n  trigger: { manual: true }, handler: replayCancelled\n});"},
    "handler.manual": {"path": "jobs.ts.txt","startLine": 11,"endLine": 11,"text": "function replayCancelled(input) { return inspectReplay(input.orderId); }"},
    "fraud.register": {"path": "fraud-plugin.ts.txt","startLine": 2,"endLine": 2,"text": "pluginRegistry.register(\"fraud-v1\", onFraudCancelled);"},
    "handler.fraud": {"path": "fraud-plugin.ts.txt","startLine": 3,"endLine": 6,"text": "async function onFraudCancelled(bytes, fraudStore) {\n  const decoded = decode(\"orders.cancelled.v1\", bytes);\n  await fraudStore.recordCancellation(decoded.orderId);\n}"},
    "channel.primary": {"path": "wiring.ts.txt","startLine": 2,"endLine": 2,"text": "const primary = channel(\"orders.primary\", \"Order events\", \"kafka\", \"orders.cancelled\", \"orders\");"},
    "channel.secondary": {"path": "wiring.ts.txt","startLine": 3,"endLine": 3,"text": "const secondary = channel(\"orders.secondary\", \"Order events\", \"kafka\", \"orders.cancelled.secondary\", \"orders\");"},
    "channel.returns": {"path": "wiring.ts.txt","startLine": 4,"endLine": 4,"text": "const returns = channel(\"returns.primary\", \"Order events\", \"kafka\", \"returns.cancelled\", \"returns\");"},
    "channel.retry": {"path": "wiring.ts.txt","startLine": 5,"endLine": 5,"text": "const retry = channel(\"orders.retry\", \"Retry\", \"kafka\", \"orders.retry\", \"orders\");"},
    "channel.dlq": {"path": "wiring.ts.txt","startLine": 6,"endLine": 6,"text": "const dlq = channel(\"orders.dlq\", \"DLQ\", \"kafka\", \"orders.dlq\", \"orders\");"},
    "channel.orphan": {"path": "wiring.ts.txt","startLine": 7,"endLine": 7,"text": "const orphan = channel(\"orders.orphan\", \"Orphan\", \"kafka\", \"orders.orphan\", \"orders\");"},
    "consumer.cancel": {"path": "wiring.ts.txt","startLine": 8,"endLine": 8,"text": "const known = consumer(\"billing.cancel\", \"Cancel order\", onOrderCancelled);"},
    "delivery.primary": {"path": "wiring.ts.txt","startLine": 9,"endLine": 9,"text": "subscribe(primary, \"orders.cancelled.v1\", known, { group: \"billing\", condition: \"type=cancelled\" });"},
    "delivery.secondary": {"path": "wiring.ts.txt","startLine": 10,"endLine": 10,"text": "subscribe(secondary, \"orders.cancelled.v1\", known, { group: \"billing\", condition: \"type=cancelled\" });"},
    "consumer.return": {"path": "wiring.ts.txt","startLine": 11,"endLine": 11,"text": "const distinct = consumer(\"billing.return\", \"Cancel order\", onReturnCancelled);"},
    "delivery.returns": {"path": "wiring.ts.txt","startLine": 12,"endLine": 12,"text": "subscribe(returns, \"returns.cancelled.v1\", distinct, { group: \"billing\", condition: \"type=cancelled\" });"},
    "retry": {"path": "wiring.ts.txt","startLine": 13,"endLine": 13,"text": "configureRetry(known, retry, \"orders.cancelled.v1\", { delay: \"PT30S\", maxAttempts: 3, reason: \"transient failure\" });"},
    "dlq": {"path": "wiring.ts.txt","startLine": 14,"endLine": 14,"text": "configureDLQ(known, dlq, \"orders.cancelled.v1\", { reason: \"retry attempts exhausted\" });"},
    "consumer.orphan": {"path": "wiring.ts.txt","startLine": 15,"endLine": 15,"text": "const orphanConsumer = consumer(\"billing.orphan\", \"Orphan listener\", onOrphan);"},
    "delivery.orphan": {"path": "wiring.ts.txt","startLine": 16,"endLine": 16,"text": "subscribe(orphan, \"orders.cancelled.v1\", orphanConsumer, { group: \"billing-orphan\", condition: \"all\" });"},
    "consumer.fraud": {"path": "wiring.ts.txt","startLine": 17,"endLine": 17,"text": "const fraud = consumerFromPlugin(\"billing.fraud\", \"Fraud cancellation\", \"fraud-v1\");"},
    "delivery.fraud": {"path": "wiring.ts.txt","startLine": 18,"endLine": 18,"text": "subscribe(primary, \"orders.cancelled.v1\", fraud, { group: \"fraud\", condition: \"risk=high\" });"},
    "consumer.audit": {"path": "wiring.ts.txt","startLine": 19,"endLine": 19,"text": "const audit = dynamicConsumer(\"billing.audit\", \"Audit\", { cancelled: onAudit }, runtimeDispatchKey);"},
    "delivery.audit": {"path": "wiring.ts.txt","startLine": 20,"endLine": 20,"text": "subscribe(primary, \"orders.cancelled.v1\", audit, { group: \"audit\", condition: \"all\" });"},
    "consumer.legacy": {"path": "wiring.ts.txt","startLine": 21,"endLine": 21,"text": "const legacy = consumerFromModule(\"billing.legacy\", \"Legacy cancellation\", \"../private-ledger/cancel\");"},
    "delivery.legacy": {"path": "wiring.ts.txt","startLine": 22,"endLine": 22,"text": "subscribe(primary, \"orders.cancelled.v1\", legacy, { group: \"legacy\", condition: \"all\" });"},
    "database.config": {"path": "orders.ts.txt","startLine": 29,"endLine": 31,"text": "const ordersDatabase = configureDatabase(\"orders\", { dialect: \"postgresql\" });\nbindDatabase(cancelOrder, ordersDatabase);\nbindDatabase(sweepCancelled, ordersDatabase);"}
