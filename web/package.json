{
  "name": "mocker-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "yarn gen && vite",
    "build": "yarn gen && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "gen": "orval --config ./orval.config.ts && tsr generate"
  },
  "dependencies": {
    "@mantine/core": "9.5.1",
    "@mantine/dates": "9.5.1",
    "@mantine/dropzone": "9.5.1",
    "@mantine/form": "9.5.1",
    "@mantine/hooks": "9.5.1",
    "@mantine/modals": "9.5.1",
    "@mantine/notifications": "9.5.1",
    "@sentry/react": "10.70.0",
    "@tabler/icons-react": "3.46.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.30",
    "arktype": "2.2.3",
    "dayjs": "1.11.23",
    "marked": "18.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "5.4.0",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/router-cli": "1.167.31",
    "@tanstack/router-core": "1.171.25",
    "@tanstack/router-plugin": "1.168.33",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "happy-dom": "20.14.0",
    "orval": "8.24.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "postcss": "8.5.26",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "5.0.0"
  },
  "resolutions": {
    "react-reconciler": "0.33.0"
  },
